# Black Sheep - local development environment.
#
# The rival fund's LLM brain calls Anthropic. The key lives ONLY on the dev
# server (injected by the Vite proxy in vite.config.ts for the browser path,
# and read directly by server/world.ts for the backend path) and is never
# bundled into the browser. Copy this file to `.env` and fill in your key.
#
#   cp .env.example .env
#   # then edit .env
#
# Without ANTHROPIC_API_KEY the rival silently falls back to its rule-based
# twin, so the game still runs - you just won't see LLM-generated reasoning.

ANTHROPIC_API_KEY=

# Postgres for the game server (docker compose up -d).
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/black_sheep?schema=public

# JWT signing secret. Leave empty in dev: the server generates an ephemeral
# per-boot secret (all sessions die on restart). Set a long random value for
# anything longer-lived.
JWT_SECRET=

