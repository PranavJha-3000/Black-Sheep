generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PositionDirection {
  long
  short
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// The persistent financial world. One row per world; the server runs the one
// named "live" (D-016). The seed is chosen once at creation and persisted so a
// restart resumes the same world instead of reseeding it (D-018).
model World {
  id           Int                   @id @default(autoincrement())
  name         String                @unique
  seed         Int
  createdAt    DateTime              @default(now())
  funds        Fund[]
  ticks        MarketTick[]
  events       MarketEventLog[]
  decisions    RivalDecisionLog[]
  liquidations LiquidationLog[]
  llmCalls     LlmCallLog[]
  memories     AgentMemory[]
  navSnapshots FundNavSnapshot[]
  director     DirectorDecisionLog[]
}

model Fund {
  id              Int                @id @default(autoincrement())
  worldId         Int
  world           World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  // Every fund is an AI fund; humans only observe. Unique per world.
  name            String
  cash            Float
  startingCapital Float
  createdAt       DateTime           @default(now())
  // Set server-authoritatively by the world tick loop when checkLiquidation
  // flags the fund. A liquidated fund stays visible and stops deciding (D-019).
  liquidated      Boolean            @default(false)
  // All-time high NAV. Updated whenever the fund's NAV exceeds this value
  // (trade fills, market moves). Shown to observers as the fund's high-water mark.
  peakNav         Float              @default(0)
  positions       Position[]
  decisions       RivalDecisionLog[]
  liquidations    LiquidationLog[]
  llmCalls        LlmCallLog[]
  memories        AgentMemory[]
  navSnapshots    FundNavSnapshot[]

  @@unique([worldId, name])
}

model Position {
  id             Int               @id @default(autoincrement())
  fundId         Int
  fund           Fund              @relation(fields: [fundId], references: [id], onDelete: Cascade)
  ticker         String
  direction      PositionDirection
  quantity       Float
  entryPrice     Float
  entryTimestamp DateTime
  closedAt       DateTime?
  exitPrice      Float?

  @@index([fundId, closedAt])
}

model MarketTick {
  id           Int      @id @default(autoincrement())
  worldId      Int
  world        World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  timestamp    DateTime @default(now())
  snapshotJson String

  @@index([worldId, timestamp])
}

model MarketEventLog {
  id                 Int      @id @default(autoincrement())
  worldId            Int
  world              World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  timestamp          DateTime @default(now())
  type               String
  ticker             String?
  headline           String
  priceImpactPercent Float
  // Engine tick unit at which the event fired — lets the client render the
  // same relative timeline the local Phase-2 simulation had, instead of
  // wall-clock times.
  tickCountAt        Int?

  @@index([worldId, timestamp])
}

model RivalDecisionLog {
  id          Int         @id @default(autoincrement())
  worldId     Int
  world       World       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  fundId      Int
  fund        Fund        @relation(fields: [fundId], references: [id], onDelete: Cascade)
  timestamp   DateTime    @default(now())
  action      String
  ticker      String?
  reasoning   String
  // Execution telemetry + display fields the client UI needs. fillPrice /
  // realizedPnL are written ONLY when the decision actually filled (a rejected
  // trade logs the decision but no telemetry), so observers can tell an
  // executed decision from a rejected one. confidence is the brain's stated
  // conviction (0..1). tickCountAt is the engine tick unit.
  confidence  Float?
  fillPrice   Float?
  realizedPnL Float?
  tickCountAt Int?
  // Where the decision came from (D-025): 'llm' (a model's submit), 'policy'
  // (no key, no material change skipped, or the call failed), 'budget' (the
  // fund's budget refused the call). model is the model that served it.
  source      String      @default("policy")
  model       String?
  llmCallId   Int?
  llmCall     LlmCallLog? @relation(fields: [llmCallId], references: [id], onDelete: SetNull)

  @@index([worldId, timestamp])
  @@index([fundId, timestamp])
}

// One provider call per row: what it cost and how it ended (VISION §12). The
// budget ledger is seeded from today's rows on boot.
model LlmCallLog {
  id               Int                @id @default(autoincrement())
  worldId          Int
  world            World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  fundId           Int
  fund             Fund               @relation(fields: [fundId], references: [id], onDelete: Cascade)
  timestamp        DateTime           @default(now())
  provider         String
  model            String
  servedBy         String?
  purpose          String
  outcome          String
  rounds           Int
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int
  cacheWriteTokens Int
  costUsd          Float
  latencyMs        Int
  error            String?
  toolCalls        ToolCallLog[]
  decisions        RivalDecisionLog[]

  @@index([fundId, timestamp])
  @@index([worldId, timestamp])
}

// Every research tool a model invoked during a call (VISION §9: inputs,
// outputs, latency).
model ToolCallLog {
  id         Int        @id @default(autoincrement())
  llmCallId  Int
  llmCall    LlmCallLog @relation(fields: [llmCallId], references: [id], onDelete: Cascade)
  timestamp  DateTime   @default(now())
  name       String
  inputJson  String
  outputJson String
  ok         Boolean
  latencyMs  Int

  @@index([llmCallId])
}

/**
 * A record of a fund being force-liquidated by the server. Written once per
 * liquidation event by the world tick loop — the definitive "this fund died
 * here, for this reason" fact the observer API reads its cause from.
 * `rivalContext` is a legacy column from the player-vs-rival era; the live
 * world always writes null (D-019).
 */
model LiquidationLog {
  id              Int      @id @default(autoincrement())
  worldId         Int
  world           World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  fundId          Int
  fund            Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  timestamp       DateTime @default(now())
  startingCapital Float
  peakNav         Float
  finalNav        Float
  cause           String
  rivalContext    String?
  tickCountAt     Int
  durationTicks   Int

  @@index([fundId])
  @@index([worldId, timestamp])
}

// A fund's persistent memory (VISION §7, D-026): episodic (its trades,
// closes, liquidation), reflective (deterministic summaries of recent closes)
// and relationship (other funds' public moves on its book). Written by the
// server from pure engine rules; shown back to the fund's model. Memory, not
// learning: no model or policy is updated.
model AgentMemory {
  id          Int      @id @default(autoincrement())
  worldId     Int
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  fundId      Int
  fund        Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  timestamp   DateTime @default(now())
  tickCountAt Int
  kind        String
  subject     String?
  content     String
  importance  Float
  outcomeUsd  Float?

  @@index([fundId, id])
}

// Every fund's NAV at each market snapshot tick (D-028): the series the
// performance metrics (return, drawdown, volatility, Sharpe) are computed from.
model FundNavSnapshot {
  id            Int      @id @default(autoincrement())
  worldId       Int
  world         World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  fundId        Int
  fund          Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  timestamp     DateTime @default(now())
  tickCountAt   Int
  nav           Float
  grossExposure Float

  @@index([fundId, id])
}

// Every World Director cycle (D-029), including "no intervention", so the
// none / rule / jev configurations can be compared (VISION §8).
model DirectorDecisionLog {
  id            Int      @id @default(autoincrement())
  worldId       Int
  world         World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  timestamp     DateTime @default(now())
  tickCountAt   Int
  mode          String
  kind          String
  sector        String?
  rationale     String
  applied       Boolean
  eventHeadline String?

  @@index([worldId, id])
}

/// A controlled experiment (VISION §10 Mode B, D-032): one variable varied
/// across arms, every arm run on the same seeds, independent of the live
/// world. Spec, reproducibility manifest and results are stored as JSON.
model Experiment {
  id             Int                  @id @default(autoincrement())
  createdAt      DateTime             @default(now())
  name           String
  /// queued | running | done | failed
  status         String               @default("queued")
  variable       String
  specJson       String
  manifestJson   String
  resultJson     String?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  /// Model spend actually incurred (USD); 0 for policy-only experiments.
  costUsd        Float                @default(0)
  /// Any arm has a model-decided fund: such a run is never re-queued after a restart (it would pay twice).
  hasModelBrains Boolean              @default(false)
  decisions      ExperimentDecision[]

  @@index([status, id])
}

/// Every decision of every experiment run (policy, model and fallback), so a
/// run can be replayed and exported. Written in one batch per run.
model ExperimentDecision {
  id            Int        @id @default(autoincrement())
  experimentId  Int
  experiment    Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  arm           String
  seed          Int
  tick          Int
  fundKey       String
  /// policy | llm | fallback
  source        String
  model         String?
  action        String
  ticker        String?
  dollarAmount  Float?
  confidence    Float?
  reasoning     String
  costUsd       Float
  inputTokens   Int
  outputTokens  Int
  latencyMs     Int
  toolCallsJson String
  outcome       String?

  @@index([experimentId, arm, seed, tick])
}
